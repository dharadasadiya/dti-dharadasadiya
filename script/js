/* =====================================================
   ECOCAMPUS - JAVASCRIPT
   ===================================================== */


/* ================= MOBILE MENU ================= */

const menuBtn = document.getElementById("menuBtn");
const navLinks = document.getElementById("navLinks");

if (menuBtn) {

    menuBtn.addEventListener("click", () => {

        navLinks.classList.toggle("open");

        const icon = menuBtn.querySelector("i");

        if (navLinks.classList.contains("open")) {

            icon.classList.remove("fa-bars");
            icon.classList.add("fa-xmark");

        } else {

            icon.classList.remove("fa-xmark");
            icon.classList.add("fa-bars");

        }

    });

}


/* Close mobile menu */

document.querySelectorAll(".nav-links a").forEach(link => {

    link.addEventListener("click", () => {

        navLinks.classList.remove("open");

        const icon = menuBtn?.querySelector("i");

        if (icon) {

            icon.classList.remove("fa-xmark");
            icon.classList.add("fa-bars");

        }

    });

});


/* ================= DARK MODE ================= */

const themeBtn = document.getElementById("themeBtn");

themeBtn?.addEventListener("click", () => {

    document.body.classList.toggle("dark");

    const icon = themeBtn.querySelector("i");

    if (document.body.classList.contains("dark")) {

        icon.classList.remove("fa-moon");
        icon.classList.add("fa-sun");

        showToast(
            "Dark Mode",
            "Dark theme enabled."
        );

    } else {

        icon.classList.remove("fa-sun");
        icon.classList.add("fa-moon");

        showToast(
            "Light Mode",
            "Light theme enabled."
        );

    }

});


/* ================= TOAST ================= */

let toastTimer;

function showToast(title, message) {

    const toast = document.getElementById("toast");

    document.getElementById("toastTitle").textContent = title;

    document.getElementById("toastMessage").textContent = message;

    toast.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer = setTimeout(() => {

        toast.classList.remove("show");

    }, 3500);

}


/* ================= WASTE MODAL ================= */

const wasteData = {

    "Wet Waste": {
        title: "Wet Waste",
        text: "Wet waste includes food scraps, vegetable peels, fruit waste and other biodegradable organic materials. Put it in the designated wet-waste bin."
    },

    "Dry Waste": {
        title: "Dry Waste",
        text: "Dry waste includes paper, cardboard, packaging materials and other clean recyclable items. Keep these materials dry before disposal."
    },

    "Plastic Waste": {
        title: "Plastic Waste",
        text: "Plastic bottles, containers and recyclable plastic items should be collected separately and placed in the appropriate recycling bin."
    },

    "E-Waste": {
        title: "E-Waste",
        text: "Electronic waste includes old chargers, batteries, phones, cables and electronic devices. Never throw e-waste into regular bins."
    }

};


function showWaste(type) {

    const data = wasteData[type];

    if (!data) return;

    document.getElementById("modalTitle").textContent =
        data.title;

    document.getElementById("modalText").textContent =
        data.text;

    document.getElementById("wasteModal")
        .classList.add("show");

}


function closeWaste() {

    document.getElementById("wasteModal")
        .classList.remove("show");

}


/* Close modal by clicking outside */

document.getElementById("wasteModal")
    ?.addEventListener("click", function(event) {

        if (event.target === this) {

            closeWaste();

        }

    });


/* ================= BIN SEARCH ================= */

function searchBin() {

    const input =
        document.getElementById("binSearch");

    const search =
        input.value.toLowerCase().trim();

    const items =
        document.querySelectorAll(".bin-item");

    let found = false;

    items.forEach(item => {

        const text =
            item.textContent.toLowerCase();

        if (!search || text.includes(search)) {

            item.style.display = "flex";

            found = true;

        } else {

            item.style.display = "none";

        }

    });

    if (found) {

        showToast(
            "Location Found",
            "Matching campus bins are displayed."
        );

    } else {

        showToast(
            "No Result",
            "No matching bin location found."
        );

    }

}


/* Search with Enter */

document.getElementById("binSearch")
    ?.addEventListener("keydown", function(event) {

        if (event.key === "Enter") {

            searchBin();

        }

    });


/* ================= REPORT FORM ================= */

const reportForm =
    document.getElementById("reportForm");

reportForm?.addEventListener("submit", function(event) {

    event.preventDefault();

    const type =
        document.getElementById("wasteType").value;

    const location =
        document.getElementById("reportLocation").value;

    if (!type || !location) {

        showToast(
            "Missing Information",
            "Please complete the required fields."
        );

        return;

    }


    /* Increase points */

    addEcoPoints(50);


    /* Show success */

    showToast(
        "Report Submitted",
        "Thank you! You earned +50 Eco Points."
    );


    /* Reset form */

    reportForm.reset();

});


/* ================= ECO POINTS ================= */

let ecoPoints = 720;


function addEcoPoints(points) {

    ecoPoints += points;

    if (ecoPoints > 1000) {

        ecoPoints = 1000;

    }

    updatePoints();

}


function updatePoints() {

    const pointsElement =
        document.getElementById("ecoPoints");

    const progress =
        document.getElementById("pointsProgress");

    const text =
        document.getElementById("pointsText");

    if (pointsElement) {

        pointsElement.textContent =
            ecoPoints;

    }

    if (progress) {

        progress.style.width =
            (ecoPoints / 1000 * 100) + "%";

    }

    if (text) {

        text.textContent =
            ecoPoints + " / 1000 XP";

    }

}


/* ================= NAV ACTIVE ================= */

const sections =
    document.querySelectorAll("section[id]");

const navItems =
    document.querySelectorAll(".nav-links a");

window.addEventListener("scroll", () => {

    let current = "";

    sections.forEach(section => {

        const sectionTop =
            section.offsetTop - 130;

        if (window.scrollY >= sectionTop) {

            current = section.getAttribute("id");

        }

    });

    navItems.forEach(link => {

        link.classList.remove("active");

        if (
            link.getAttribute("href") ===
            "#" + current
        ) {

            link.classList.add("active");

        }

    });

});


/* ================= SCROLL ANIMATION ================= */

const observer =
    new IntersectionObserver(
        entries => {

            entries.forEach(entry => {

                if (entry.isIntersecting) {

                    entry.target.style.opacity = "1";
                    entry.target.style.transform =
                        "translateY(0)";

                }

            });

        },
        {
            threshold: 0.12
        }
    );


document
    .querySelectorAll(
        ".impact-card, .waste-card, .tip-card, .leader-row"
    )
    .forEach(element => {

        element.style.opacity = "0";

        element.style.transform =
            "translateY(20px)";

        element.style.transition =
            "opacity .6s ease, transform .6s ease";

        observer.observe(element);

    });


/* ================= INITIALIZE ================= */

updatePoints();

console.log(
    "EcoCampus loaded successfully 🌱"
);
