
/* =====================================================
   ECOCAMPUS - PROFESSIONAL UI
   ===================================================== */

:root {
    --primary: #1f9d55;
    --primary-dark: #147a40;
    --primary-light: #eaf8ef;

    --dark: #102218;
    --dark-2: #172c20;

    --text: #26352c;
    --muted: #708077;

    --white: #ffffff;
    --bg: #f7faf8;
    --border: #e2ebe5;

    --shadow: 0 20px 50px rgba(22, 54, 37, 0.08);

    --radius: 20px;

    --transition: 0.3s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Inter", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
}

body.dark {
    --bg: #0b1510;
    --white: #122119;
    --dark: #ffffff;
    --dark-2: #eaf8ef;
    --text: #e3eee7;
    --muted: #9bac9f;
    --border: #26392d;

    background: #0b1510;
}

button,
input,
textarea,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: min(1180px, 92%);
    margin: auto;
}


/* ================= NAVBAR ================= */

.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(255,255,255,0.88);
    backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(220,230,223,0.7);
}

body.dark .navbar {
    background: rgba(11,21,16,0.9);
    border-color: var(--border);
}

.nav-container {
    height: 76px;

    width: min(1240px, 94%);
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;

    font-family: "Manrope", sans-serif;
    font-size: 21px;
    font-weight: 800;
    color: var(--dark);
}

.logo > span:last-child > span {
    color: var(--primary);
}

.logo-icon {
    width: 39px;
    height: 39px;

    display: grid;
    place-items: center;

    color: white;
    background: var(--primary);

    border-radius: 12px;

    box-shadow: 0 8px 20px rgba(31,157,85,0.25);
}

.nav-links {
    display: flex;
    gap: 27px;
}

.nav-links a {
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;

    position: relative;
}

.nav-links a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -8px;

    width: 0;
    height: 2px;

    background: var(--primary);

    transition: var(--transition);
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--primary);
}

.nav-links a:hover::after,
.nav-links a.active::after {
    width: 100%;
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.theme-btn,
.menu-btn {
    border: 1px solid var(--border);
    background: var(--white);

    width: 40px;
    height: 40px;

    border-radius: 11px;

    color: var(--dark);

    transition: var(--transition);
}

.theme-btn:hover,
.menu-btn:hover {
    color: var(--primary);
    transform: translateY(-2px);
}

.menu-btn {
    display: none;
}


/* ================= HERO ================= */

.hero {
    min-height: 690px;

    display: flex;
    align-items: center;

    padding: 80px 0;

    background:
        radial-gradient(circle at 85% 30%, rgba(31,157,85,0.12), transparent 30%),
        radial-gradient(circle at 10% 90%, rgba(31,157,85,0.07), transparent 25%);
}

.hero-container {
    width: min(1180px, 92%);
    margin: auto;

    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 70px;
    align-items: center;
}

.eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    padding: 8px 13px;

    border-radius: 100px;

    background: var(--primary-light);
    color: var(--primary-dark);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
}

.pulse {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--primary);

    box-shadow: 0 0 0 5px rgba(31,157,85,0.12);
}

.hero h1 {
    margin-top: 22px;

    font-family: "Manrope", sans-serif;

    font-size: clamp(42px, 5vw, 66px);
    line-height: 1.04;

    letter-spacing: -2.8px;

    color: var(--dark);
}

.hero h1 span {
    display: block;
    color: var(--primary);
}

.hero-content > p {
    max-width: 570px;

    margin-top: 25px;

    color: var(--muted);

    font-size: 16px;
}

.hero-buttons {
    display: flex;
    gap: 13px;

    margin-top: 32px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    padding: 14px 21px;

    border-radius: 12px;

    font-size: 13px;
    font-weight: 700;

    transition: var(--transition);
}

.btn-primary {
    background: var(--primary);
    color: white;

    box-shadow: 0 12px 25px rgba(31,157,85,0.22);
}

.btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-3px);
}

.btn-outline {
    border: 1px solid var(--border);
    background: var(--white);
    color: var(--dark);
}

.btn-outline:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-3px);
}

.hero-trust {
    display: flex;
    align-items: center;
    gap: 12px;

    margin-top: 38px;
}

.avatars {
    display: flex;
}

.avatars span {
    width: 32px;
    height: 32px;

    margin-left: -7px;

    display: grid;
    place-items: center;

    border: 2px solid var(--bg);
    border-radius: 50%;

    background: var(--primary);
    color: white;

    font-size: 10px;
    font-weight: 800;
}

.avatars span:first-child {
    margin-left: 0;
}

.hero-trust strong,
.hero-trust small {
    display: block;
}

.hero-trust strong {
    color: var(--dark);
    font-size: 12px;
}

.hero-trust small {
    color: var(--muted);
    font-size: 10px;
}


/* ================= HERO DASHBOARD ================= */

.hero-dashboard {
    position: relative;
}

.dashboard-window {
    overflow: hidden;

    border: 1px solid var(--border);

    border-radius: 22px;

    background: var(--white);

    box-shadow: 0 35px 80px rgba(20,55,35,0.14);

    transform: rotate(1deg);

    transition: var(--transition);
}

.dashboard-window:hover {
    transform: rotate(0deg) translateY(-5px);
}

.window-top {
    height: 50px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 18px;

    border-bottom: 1px solid var(--border);

    color: var(--muted);

    font-size: 10px;
    font-weight: 700;
}

.window-dots {
    display: flex;
    gap: 5px;
}

.window-dots span {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #d8e2db;
}

.dashboard-content {
    padding: 25px;
}

.dashboard-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.dashboard-heading small {
    color: var(--muted);
    font-size: 10px;
}

.dashboard-heading h3 {
    color: var(--dark);
    font-size: 17px;
}

.status {
    padding: 6px 9px;

    border-radius: 20px;

    background: var(--primary-light);
    color: var(--primary);

    font-size: 9px;
    font-weight: 700;
}

.status i {
    font-size: 5px;
}

.mini-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 12px;

    margin-top: 20px;
}

.mini-card {
    display: flex;
    align-items: center;
    gap: 11px;

    padding: 14px;

    border: 1px solid var(--border);

    border-radius: 13px;
}

.mini-icon {
    width: 37px;
    height: 37px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    background: var(--primary-light);
    color: var(--primary);

    font-size: 13px;
}

.mini-icon.blue,
.blue-icon {
    background: #edf5ff;
    color: #3b82f6;
}

.mini-card strong,
.mini-card small {
    display: block;
}

.mini-card strong {
    color: var(--dark);
    font-size: 13px;
}

.mini-card small {
    color: var(--muted);
    font-size: 9px;
}

.chart-card {
    margin-top: 13px;

    padding: 17px;

    border: 1px solid var(--border);

    border-radius: 15px;
}

.chart-header {
    display: flex;
    justify-content: space-between;

    color: var(--muted);

    font-size: 10px;
}

.chart-header strong {
    color: var(--primary);
}

.fake-chart {
    height: 140px;

    display: flex;
    align-items: end;
    justify-content: space-around;

    gap: 12px;

    margin-top: 15px;

    border-bottom: 1px solid var(--border);
}

.bar {
    width: 25px;

    border-radius: 7px 7px 0 0;

    background: #cdebd8;

    transition: var(--transition);
}

.bar:hover,
.active-bar {
    background: var(--primary);
}

.chart-days {
    display: flex;
    justify-content: space-around;

    margin-top: 7px;

    color: var(--muted);
    font-size: 8px;
}

.floating-card {
    position: absolute;

    display: flex;
    align-items: center;
    gap: 10px;

    padding: 11px 15px;

    border: 1px solid var(--border);

    border-radius: 13px;

    background: var(--white);

    box-shadow: var(--shadow);

    animation: float 4s ease-in-out infinite;
}

.floating-one {
    left: -35px;
    bottom: 50px;
}

.floating-two {
    right: -30px;
    top: 60px;

    animation-delay: 1s;
}

.float-icon {
    width: 32px;
    height: 32px;

    display: grid;
    place-items: center;

    border-radius: 9px;

    background: var(--primary-light);
    color: var(--primary);

    font-size: 12px;
}

.floating-card strong,
.floating-card small {
    display: block;
}

.floating-card strong {
    color: var(--dark);
    font-size: 12px;
}

.floating-card small {
    color: var(--muted);
    font-size: 9px;
}

@keyframes float {
    50% {
        transform: translateY(-8px);
    }
}


/* ================= SECTION ================= */

.section {
    padding: 100px 0;
}

.impact-section {
    padding: 85px 0;
    background: var(--white);
}

.section-heading {
    max-width: 700px;
    margin-bottom: 45px;
}

.section-heading.center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
}

.section-label {
    color: var(--primary);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.section-heading h2,
.report-info h2,
.points-left h2,
.cta-box h2 {
    margin-top: 10px;

    font-family: "Manrope", sans-serif;

    color: var(--dark);

    font-size: clamp(30px, 4vw, 44px);

    line-height: 1.15;

    letter-spacing: -1.5px;
}

.section-heading h2 span,
.report-info h2 span,
.points-left h2 span,
.cta-box h2 span {
    color: var(--primary);
}

.section-heading p {
    margin-top: 12px;

    color: var(--muted);

    font-size: 14px;
}


/* ================= IMPACT ================= */

.impact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 15px;
}

.impact-card {
    padding: 25px;

    border: 1px solid var(--border);
    border-radius: 18px;

    background: var(--white);

    transition: var(--transition);
}

.impact-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: #b9dcc5;
}

.impact-icon {
    width: 43px;
    height: 43px;

    display: grid;
    place-items: center;

    margin-bottom: 20px;

    border-radius: 12px;

    background: var(--primary-light);
    color: var(--primary);
}

.impact-card strong,
.impact-card span,
.impact-card small {
    display: block;
}

.impact-card strong {
    color: var(--dark);
    font-family: "Manrope", sans-serif;
    font-size: 27px;
}

.impact-card > span {
    color: var(--muted);
    font-size: 12px;
}

.impact-card small {
    margin-top: 13px;

    color: var(--primary);

    font-size: 9px;
    font-weight: 700;
}


/* ================= WASTE ================= */

.waste-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 16px;
}

.waste-card {
    text-align: left;

    padding: 25px;

    border: 1px solid var(--border);
    border-radius: 18px;

    background: var(--white);

    transition: var(--transition);
}

.waste-card:hover {
    transform: translateY(-7px);
    box-shadow: var(--shadow);
}

.waste-icon {
    width: 50px;
    height: 50px;

    display: grid;
    place-items: center;

    margin-bottom: 22px;

    border-radius: 14px;

    background: var(--primary-light);
    color: var(--primary);

    font-size: 19px;
}

.waste-card h3 {
    color: var(--dark);
    font-size: 17px;
}

.waste-card p {
    min-height: 58px;

    margin: 8px 0 17px;

    color: var(--muted);

    font-size: 11px;
}

.waste-card span {
    color: var(--primary);

    font-size: 10px;
    font-weight: 800;
}

.waste-card span i {
    margin-left: 5px;
}

.waste-card:hover span i {
    transform: translateX(4px);
}


/* ================= LOCATOR ================= */

.locator-section {
    background: var(--white);
}

.locator-box {
    display: grid;
    grid-template-columns: 1fr 0.9fr;

    overflow: hidden;

    border: 1px solid var(--border);
    border-radius: 25px;

    background: var(--bg);

    box-shadow: var(--shadow);
}

.locator-content {
    padding: 45px;
}

.locator-content h2 {
    margin-top: 9px;

    font-family: "Manrope", sans-serif;

    color: var(--dark);

    font-size: 36px;
    line-height: 1.15;
}

.locator-content h2 span {
    color: var(--primary);
}

.locator-content > p {
    margin: 13px 0 25px;

    color: var(--muted);

    font-size: 13px;
}

.location-search {
    display: flex;

    height: 48px;

    overflow: hidden;

    border: 1px solid var(--border);
    border-radius: 11px;

    background: var(--white);
}

.location-search > i {
    align-self: center;

    margin-left: 15px;

    color: var(--muted);

    font-size: 12px;
}

.location-search input {
    flex: 1;

    min-width: 0;

    padding: 0 12px;

    border: 0;
    outline: 0;

    background: transparent;

    color: var(--text);

    font-size: 11px;
}

.location-search button {
    padding: 0 17px;

    border: 0;

    background: var(--primary);
    color: white;

    font-size: 10px;
    font-weight: 700;
}

.bin-list {
    margin-top: 20px;
}

.bin-item {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 13px 0;

    border-bottom: 1px solid var(--border);
}

.bin-location-icon {
    width: 37px;
    height: 37px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    background: var(--white);

    color: var(--primary);

    font-size: 12px;
}

.bin-item > div:nth-child(2) {
    flex: 1;
}

.bin-item strong,
.bin-item small {
    display: block;
}

.bin-item strong {
    color: var(--dark);
    font-size: 11px;
}

.bin-item small {
    color: var(--muted);
    font-size: 9px;
}

.available,
.full {
    padding: 5px 8px;

    border-radius: 20px;

    font-size: 8px;
    font-weight: 700;
}

.available {
    background: var(--primary-light);
    color: var(--primary);
}

.full {
    background: #fff3e5;
    color: #d97706;
}

.map-area {
    position: relative;

    min-height: 450px;

    overflow: hidden;

    background:
        linear-gradient(90deg, rgba(31,157,85,0.04) 1px, transparent 1px),
        linear-gradient(rgba(31,157,85,0.04) 1px, transparent 1px);

    background-size: 40px 40px;
}

.map-road {
    position: absolute;

    background: #dce9e1;
}

.road-one {
    width: 120%;
    height: 32px;

    left: -10%;
    top: 48%;

    transform: rotate(-12deg);
}

.road-two {
    width: 32px;
    height: 120%;

    left: 52%;
    top: -10%;

    transform: rotate(18deg);
}

.map-building {
    position: absolute;

    display: grid;
    place-items: center;

    border: 1px solid #c9ddcf;

    border-radius: 10px;

    background: #eaf4ed;

    color: #5c7565;

    font-size: 9px;
    font-weight: 700;
}

.building-one {
    width: 100px;
    height: 70px;

    left: 18%;
    top: 20%;
}

.building-two {
    width: 85px;
    height: 90px;

    right: 17%;
    top: 17%;
}

.building-three {
    width: 80px;
    height: 55px;

    left: 35%;
    bottom: 16%;
}

.map-pin {
    position: absolute;

    width: 35px;
    height: 35px;

    border: 0;

    border-radius: 50% 50% 50% 0;

    background: var(--primary);
    color: white;

    transform: rotate(-45deg);

    box-shadow: 0 7px 15px rgba(31,157,85,0.3);
}

.map-pin i {
    transform: rotate(45deg);
}

.pin-one {
    left: 35%;
    top: 34%;
}

.pin-two {
    right: 28%;
    top: 48%;
}

.pin-three {
    left: 47%;
    bottom: 20%;
}

.map-label {
    position: absolute;

    left: 20px;
    bottom: 20px;

    padding: 9px 12px;

    border-radius: 10px;

    background: var(--white);

    box-shadow: var(--shadow);

    color: var(--dark);

    font-size: 9px;
    font-weight: 700;
}


/* ================= REPORT ================= */

.report-layout {
    display: grid;
    grid-template-columns: 0.9fr 1fr;

    gap: 80px;

    align-items: center;
}

.report-info > p {
    max-width: 480px;

    margin-top: 15px;

    color: var(--muted);

    font-size: 14px;
}

.report-benefit {
    display: flex;
    align-items: center;
    gap: 13px;

    margin-top: 24px;
}

.report-benefit > div:first-child {
    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border-radius: 11px;

    background: var(--primary-light);
    color: var(--primary);
}

.report-benefit strong,
.report-benefit span {
    display: block;
}

.report-benefit strong {
    color: var(--dark);
    font-size: 11px;
}

.report-benefit span {
    color: var(--muted);
    font-size: 9px;
}

.report-card {
    padding: 28px;

    border: 1px solid var(--border);
    border-radius: 20px;

    background: var(--white);

    box-shadow: var(--shadow);
}

.form-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    margin-bottom: 23px;
}

.form-header span {
    color: var(--primary);

    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
}

.form-header h3 {
    margin-top: 3px;

    color: var(--dark);

    font-size: 18px;
}

.report-number {
    color: var(--muted);
    font-size: 8px;
}

.form-group {
    margin-bottom: 15px;
}

.form-group label {
    display: block;

    margin-bottom: 6px;

    color: var(--dark);

    font-size: 10px;
    font-weight: 700;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;

    padding: 12px 13px;

    border: 1px solid var(--border);
    border-radius: 10px;

    outline: 0;

    background: var(--bg);

    color: var(--text);

    font-size: 10px;

    transition: var(--transition);
}

.form-group textarea {
    resize: vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: var(--primary);

    box-shadow: 0 0 0 3px rgba(31,157,85,0.08);
}

.upload-box {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: center;

    padding: 18px;

    margin-bottom: 15px;

    border: 1px dashed #bdd3c4;

    border-radius: 11px;

    background: var(--primary-light);

    text-align: center;
}

.upload-box > i {
    color: var(--primary);
    font-size: 22px;
}

.upload-box strong {
    margin-top: 5px;

    color: var(--dark);

    font-size: 10px;
}

.upload-box small {
    color: var(--muted);
    font-size: 8px;
}

.upload-box input {
    position: absolute;

    inset: 0;

    opacity: 0;

    cursor: pointer;
}

.submit-btn {
    width: 100%;

    padding: 14px;

    border: 0;
    border-radius: 10px;

    background: var(--primary);
    color: white;

    font-size: 11px;
    font-weight: 800;

    transition: var(--transition);
}

.submit-btn:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
}

.submit-btn i {
    margin-left: 7px;
}


/* ================= TIPS ================= */

.tips-section {
    background: var(--white);
}

.tips-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 15px;
}

.tip-card {
    position: relative;

    padding: 25px;

    border: 1px solid var(--border);
    border-radius: 17px;

    transition: var(--transition);
}

.tip-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
}

.tip-number {
    position: absolute;

    top: 20px;
    right: 20px;

    color: #d7e4db;

    font-family: "Manrope", sans-serif;

    font-size: 25px;
    font-weight: 800;
}

.tip-icon {
    width: 45px;
    height: 45px;

    display: grid;
    place-items: center;

    margin-bottom: 25px;

    border-radius: 12px;

    background: var(--primary-light);
    color: var(--primary);
}

.tip-card h3 {
    color: var(--dark);
    font-size: 14px;
}

.tip-card p {
    margin-top: 8px;

    color: var(--muted);

    font-size: 10px;
}


/* ================= POINTS ================= */

.points-section {
    padding: 80px 0;

    background: #10251a;
}

.points-box {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 50px;
}

.points-left {
    max-width: 650px;
}

.points-left h2 {
    color: white;
}

.points-left h2 span {
    color: #66d18e;
}

.points-left p {
    margin-top: 13px;

    color: #a9bdb0;

    font-size: 13px;
}

.level {
    margin-top: 28px;
}

.level-info {
    display: flex;
    justify-content: space-between;

    color: white;

    font-size: 10px;
}

.level-info strong {
    color: #66d18e;
}

.progress {
    height: 8px;

    overflow: hidden;

    margin-top: 10px;

    border-radius: 20px;

    background: #294434;
}

.progress > div {
    width: 72%;
    height: 100%;

    border-radius: inherit;

    background: #55c87f;
}

.level > small {
    display: block;

    margin-top: 7px;

    color: #82998a;

    font-size: 8px;
}

.points-circle {
    width: 200px;
    height: 200px;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border: 1px solid rgba(255,255,255,0.12);

    border-radius: 50%;

    background: rgba(255,255,255,0.05);

    box-shadow:
        inset 0 0 40px rgba(85,200,127,0.08),
        0 0 50px rgba(85,200,127,0.08);
}

.points-circle > div {
    text-align: center;
}

.points-circle i {
    display: block;

    color: #66d18e;

    font-size: 20px;
}

.points-circle strong {
    display: block;

    margin-top: 3px;

    color: white;

    font-family: "Manrope", sans-serif;

    font-size: 40px;
}

.points-circle span {
    color: #82998a;

    font-size: 9px;
}


/* ================= LEADERBOARD ================= */

.leaderboard {
    max-width: 800px;
}

.leader-row {
    display: flex;
    align-items: center;
    gap: 15px;

    padding: 17px 20px;

    margin-bottom: 9px;

    border: 1px solid var(--border);
    border-radius: 13px;

    background: var(--white);

    transition: var(--transition);
}

.leader-row:hover {
    transform: translateX(5px);
}

.leader-row.current-user {
    border-color: #a7d6b7;

    background: var(--primary-light);
}

.rank {
    width: 25px;

    color: var(--muted);

    font-family: "Manrope", sans-serif;

    font-size: 11px;
    font-weight: 800;
}

.leader-avatar {
    width: 37px;
    height: 37px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: var(--primary);
    color: white;

    font-size: 11px;
    font-weight: 800;
}

.leader-name {
    flex: 1;
}

.leader-name strong,
.leader-name small {
    display: block;
}

.leader-name strong {
    color: var(--dark);
    font-size: 11px;
}

.leader-name small {
    color: var(--muted);
    font-size: 8px;
}

.leader-points {
    color: var(--primary);

    font-size: 10px;
    font-weight: 800;
}


/* ================= CTA ================= */

.cta-section {
    padding: 30px 0 100px;
}

.cta-box {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: space-between;

    overflow: hidden;

    padding: 55px;

    border-radius: 25px;

    background: #183d28;
}

.cta-decoration {
    position: absolute;

    width: 280px;
    height: 280px;

    right: -80px;
    top: -100px;

    border: 50px solid rgba(255,255,255,0.04);

    border-radius: 50%;
}

.cta-box h2 {
    color: white;
}

.cta-box h2 span {
    color: #65d18c;
}

.cta-box p {
    margin-top: 10px;

    color: #a9bdb0;

    font-size: 12px;
}

.btn-white {
    position: relative;

    background: white;
    color: #183d28;

    white-space: nowrap;
}

.btn-white:hover {
    transform: translateY(-3px);
}


/* ================= FOOTER ================= */

footer {
    padding: 65px 0 20px;

    border-top: 1px solid var(--border);

    background: var(--white);
}

.footer-main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;

    gap: 50px;

    padding-bottom: 45px;
}

.footer-brand p {
    max-width: 270px;

    margin-top: 13px;

    color: var(--muted);

    font-size: 11px;
}

.socials {
    display: flex;
    gap: 8px;

    margin-top: 18px;
}

.socials a {
    width: 32px;
    height: 32px;

    display: grid;
    place-items: center;

    border: 1px solid var(--border);
    border-radius: 9px;

    color: var(--muted);

    font-size: 11px;

    transition: var(--transition);
}

.socials a:hover {
    color: var(--primary);
    border-color: var(--primary);
}

.footer-column h4 {
    margin-bottom: 15px;

    color: var(--dark);

    font-size: 11px;
}

.footer-column a {
    display: block;

    margin-bottom: 9px;

    color: var(--muted);

    font-size: 10px;

    transition: var(--transition);
}

.footer-column a:hover {
    color: var(--primary);
    transform: translateX(3px);
}

.footer-bottom {
    display: flex;
    justify-content: space-between;

    padding-top: 20px;

    border-top: 1px solid var(--border);

    color: var(--muted);

    font-size: 8px;
}


/* ================= TOAST ================= */

.toast {
    position: fixed;

    right: 25px;
    bottom: 25px;

    z-index: 3000;

    display: flex;
    align-items: center;
    gap: 11px;

    min-width: 280px;

    padding: 14px;

    border: 1px solid var(--border);
    border-radius: 13px;

    background: var(--white);

    box-shadow: 0 20px 50px rgba(0,0,0,0.14);

    transform: translateY(130px);

    opacity: 0;

    transition: 0.4s ease;
}

.toast.show {
    transform: translateY(0);
    opacity: 1;
}

.toast-icon {
    width: 35px;
    height: 35px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    background: var(--primary-light);
    color: var(--primary);
}

.toast strong,
.toast span {
    display: block;
}

.toast strong {
    color: var(--dark);
    font-size: 10px;
}

.toast span {
    color: var(--muted);
    font-size: 9px;
}


/* ================= MODAL ================= */

.modal {
    position: fixed;

    inset: 0;

    z-index: 2000;

    display: none;
    place-items: center;

    padding: 20px;

    background: rgba(9,22,14,0.55);

    backdrop-filter: blur(8px);
}

.modal.show {
    display: grid;
}

.modal-box {
    position: relative;

    width: min(450px, 100%);

    padding: 35px;

    border-radius: 20px;

    background: var(--white);

    box-shadow: 0 30px 80px rgba(0,0,0,0.2);

    animation: modalIn 0.3s ease;
}

@keyframes modalIn {
    from {
        transform: translateY(20px) scale(0.96);
        opacity: 0;
    }

    to {
        transform: translateY(0) scale(1);
        opacity: 1;
    }
}

.modal-close {
    position: absolute;

    top: 15px;
    right: 15px;

    width: 32px;
    height: 32px;

    border: 0;
    border-radius: 8px;

    background: var(--bg);
    color: var(--muted);
}

.modal-icon {
    width: 52px;
    height: 52px;

    display: grid;
    place-items: center;

    margin-bottom: 20px;

    border-radius: 14px;

    background: var(--primary-light);
    color: var(--primary);

    font-size: 20px;
}

.modal-box h2 {
    margin-top: 7px;

    color: var(--dark);

    font-family: "Manrope", sans-serif;
}

.modal-box > p {
    margin-top: 10px;

    color: var(--muted);

    font-size: 12px;
}

.modal-tip {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-top: 20px;
    padding: 12px;

    border-radius: 10px;

    background: var(--primary-light);

    color: var(--primary);

    font-size: 10px;
}


/* ================= RESPONSIVE ================= */

@media(max-width: 1000px) {

    .nav-links {
        gap: 15px;
    }

    .hero-container {
        gap: 35px;
    }

    .impact-grid,
    .waste-grid,
    .tips-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .locator-box,
    .report-layout {
        grid-template-columns: 1fr;
    }

    .map-area {
        min-height: 400px;
    }

    .footer-main {
        grid-template-columns: 2fr 1fr 1fr;
    }
}


@media(max-width: 760px) {

    .nav-links {
        position: absolute;

        left: 4%;
        right: 4%;
        top: 70px;

        display: none;
        flex-direction: column;

        padding: 18px;

        border: 1px solid var(--border);
        border-radius: 15px;

        background: var(--white);

        box-shadow: var(--shadow);
    }

    .nav-links.open {
        display: flex;
    }

    .nav-links a {
        padding: 8px;
    }

    .menu-btn {
        display: block;
    }

    .hero {
        padding: 55px 0;
    }

    .hero-container {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 45px;
    }

    .hero-dashboard {
        margin-top: 20px;
    }

    .floating-one {
        left: -5px;
    }

    .floating-two {
        right: -5px;
    }

    .impact-grid,
    .waste-grid,
    .tips-grid {
        grid-template-columns: 1fr;
    }

    .points-box {
        flex-direction: column;
        align-items: flex-start;
    }

    .points-circle {
        width: 170px;
        height: 170px;
        align-self: center;
    }

    .cta-box {
        flex-direction: column;
        align-items: flex-start;
        gap: 25px;

        padding: 35px;
    }

    .footer-main {
        grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }

    .footer-bottom {
        flex-direction: column;
        gap: 8px;
    }
}


@media(max-width: 500px) {

    .hero-buttons {
        flex-direction: column;
    }

    .btn {
        width: 100%;
    }

    .dashboard-content {
        padding: 17px;
    }

    .mini-stats {
        grid-template-columns: 1fr;
    }

    .floating-card {
        display: none;
    }

    .locator-content {
        padding: 28px;
    }

    .report-card {
        padding: 20px;
    }

    .footer-main {
        grid-template-columns: 1fr;
    }
}
