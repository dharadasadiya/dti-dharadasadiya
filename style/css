
/* ================================
   EC0CAMPUS - PROFESSIONAL CSS
================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Inter", sans-serif;
    color: #17231c;
    background: #ffffff;
    line-height: 1.6;
}

button,
input,
select,
textarea {
    font-family: inherit;
}

button {
    cursor: pointer;
}

a {
    text-decoration: none;
    color: inherit;
}


/* ================= NAVBAR ================= */

.navbar {
    width: 100%;
    height: 76px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 7%;

    background: rgba(255, 255, 255, 0.96);

    border-bottom: 1px solid #edf1ed;

    position: sticky;
    top: 0;
    z-index: 1000;

    backdrop-filter: blur(12px);
}

.logo {
    display: flex;
    align-items: center;
    gap: 9px;

    font-size: 21px;
    font-weight: 800;
    color: #15251b;
}

.logo > span:last-child > span {
    color: #239447;
}

.logo-icon {
    font-size: 25px;
}

.navbar nav {
    display: flex;
    align-items: center;
    gap: 27px;
}

.navbar nav a {
    font-size: 13px;
    font-weight: 600;
    color: #667169;

    transition: 0.3s;
}

.navbar nav a:hover {
    color: #239447;
}

.nav-btn {
    border: none;

    background: #183d28;
    color: white;

    padding: 11px 18px;

    border-radius: 9px;

    font-size: 12px;
    font-weight: 700;

    transition: 0.3s;
}

.nav-btn:hover {
    background: #239447;
    transform: translateY(-2px);
}


/* ================= HERO ================= */

.hero {
    min-height: 650px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 80px 9%;

    background:
        radial-gradient(circle at 85% 25%, #dff8e7 0, transparent 30%),
        linear-gradient(135deg, #f8fcf9, #edf8f0);
}

.hero-content {
    max-width: 620px;
}

.badge {
    display: inline-flex;

    padding: 8px 14px;

    background: #e2f5e8;
    color: #218b42;

    border-radius: 50px;

    font-size: 12px;
    font-weight: 700;

    margin-bottom: 24px;
}

.hero h1 {
    font-size: clamp(48px, 6vw, 78px);
    line-height: 1.03;
    letter-spacing: -3px;

    margin-bottom: 25px;
}

.hero h1 span {
    color: #249447;
}

.hero p {
    max-width: 570px;

    color: #69756d;

    font-size: 16px;

    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 12px;

    margin-bottom: 25px;
}

.primary-btn,
.secondary-btn {
    padding: 14px 21px;

    border-radius: 10px;

    font-weight: 700;
    font-size: 13px;

    transition: 0.3s;
}

.primary-btn {
    border: none;
    background: #1c4a2d;
    color: white;
}

.primary-btn:hover {
    background: #267c42;
    transform: translateY(-3px);
}

.secondary-btn {
    border: 1px solid #cad8ce;
    background: white;
    color: #264332;
}

.secondary-btn:hover {
    border-color: #29934a;
    color: #29934a;
}

.hero-trust {
    display: flex;
    gap: 20px;

    color: #6a776e;

    font-size: 12px;
    font-weight: 600;
}


/* HERO VISUAL */

.hero-visual {
    width: 430px;
    height: 430px;

    position: relative;

    display: flex;
    justify-content: center;
    align-items: center;
}

.eco-circle {
    width: 310px;
    height: 310px;

    border-radius: 50%;

    background:
        radial-gradient(circle, #ffffff 0 20%, #c8efd3 21% 45%, #8ad29c 46% 100%);

    display: flex;
    align-items: center;
    justify-content: center;

    box-shadow: 0 30px 70px rgba(35, 120, 63, 0.18);
}

.circle-icon {
    font-size: 120px;

    filter: drop-shadow(0 15px 20px rgba(0,0,0,0.12));
}

.floating-card {
    position: absolute;

    display: flex;
    align-items: center;
    gap: 12px;

    background: white;

    padding: 14px 17px;

    border-radius: 13px;

    box-shadow: 0 18px 40px rgba(28, 70, 42, 0.14);

    animation: float 3s ease-in-out infinite;
}

.floating-card span {
    font-size: 25px;
}

.floating-card strong,
.floating-card small {
    display: block;
}

.floating-card strong {
    font-size: 12px;
}

.floating-card small {
    color: #7b857e;
    font-size: 10px;
}

.card-one {
    top: 70px;
    left: -5px;
}

.card-two {
    bottom: 60px;
    right: -5px;

    animation-delay: 1s;
}

@keyframes float {
    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }
}


/* ================= STATS ================= */

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 20px;

    padding: 45px 9%;

    background: white;

    border-bottom: 1px solid #edf1ed;
}

.stat-card {
    display: flex;
    align-items: center;
    gap: 15px;

    padding: 20px;

    border: 1px solid #edf1ed;
    border-radius: 15px;

    background: #fff;

    transition: 0.3s;
}

.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(30, 90, 50, 0.08);
}

.stat-icon {
    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #e9f7ed;

    border-radius: 12px;

    font-size: 23px;
}

.stat-card h2 {
    font-size: 22px;
}

.stat-card p {
    color: #78827c;
    font-size: 11px;
}


/* ================= GENERAL SECTION ================= */

.section {
    padding: 100px 9%;
}

.section-heading {
    text-align: center;
    max-width: 650px;

    margin: 0 auto 50px;
}

.section-label {
    color: #269249;

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 2px;
}

.section-heading h2 {
    font-size: 42px;
    line-height: 1.15;

    margin: 12px 0;
}

.section-heading h2 span,
.report-info h2 span,
.points-content h2 span {
    color: #269249;
}

.section-heading p {
    color: #778079;

    font-size: 14px;
}


/* ================= WASTE ================= */

.waste-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 20px;
}

.waste-card {
    padding: 28px;

    border-radius: 18px;

    border: 1px solid #e7eee9;

    transition: 0.3s;
}

.waste-card:hover {
    transform: translateY(-7px);

    box-shadow: 0 20px 45px rgba(27, 90, 47, 0.1);
}

.waste-icon {
    width: 60px;
    height: 60px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 15px;

    font-size: 28px;

    margin-bottom: 22px;
}

.wet {
    background: #f3fbef;
}

.wet .waste-icon {
    background: #dcf2d0;
}

.dry {
    background: #f7f9fc;
}

.dry .waste-icon {
    background: #e6ebf4;
}

.plastic {
    background: #fffaf0;
}

.plastic .waste-icon {
    background: #ffedbd;
}

.electronic {
    background: #f8f3fc;
}

.electronic .waste-icon {
    background: #eadbf5;
}

.waste-tag {
    font-size: 9px;
    font-weight: 800;

    color: #6d7a72;

    letter-spacing: 1px;
}

.waste-card h3 {
    font-size: 20px;
    margin: 6px 0 10px;
}

.waste-card p {
    color: #747e77;

    font-size: 12px;

    min-height: 60px;
}

.waste-card button {
    background: none;
    border: none;

    color: #258d46;

    font-size: 12px;
    font-weight: 800;

    margin-top: 15px;
}


/* ================= LOCATOR ================= */

.locator-section {
    padding: 100px 9%;

    background: #f6faf7;
}

.locator-container {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;

    gap: 30px;

    max-width: 1100px;
    margin: auto;
}

.campus-map {
    background: white;

    border: 1px solid #e2ebe5;

    border-radius: 20px;

    overflow: hidden;
}

.map-title {
    padding: 20px;

    font-size: 15px;
    font-weight: 800;

    border-bottom: 1px solid #edf1ed;
}

.map-area {
    height: 400px;

    position: relative;

    background:
        linear-gradient(90deg, rgba(40,140,70,.04) 1px, transparent 1px),
        linear-gradient(rgba(40,140,70,.04) 1px, transparent 1px);

    background-size: 40px 40px;
}

.map-building {
    position: absolute;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    width: 110px;
    height: 80px;

    background: white;

    border: 2px solid #d9e8de;
    border-radius: 12px;

    box-shadow: 0 8px 20px rgba(30, 70, 40, 0.08);

    font-size: 23px;
}

.map-building small {
    font-size: 9px;
    color: #68746d;
    margin-top: 3px;
}

.building-a {
    top: 50px;
    left: 60px;
}

.building-b {
    top: 50px;
    right: 70px;
}

.building-c {
    bottom: 55px;
    left: 100px;
}

.building-d {
    bottom: 55px;
    right: 70px;
}

.bin-point {
    position: absolute;

    width: 38px;
    height: 38px;

    display: flex;
    justify-content: center;
    align-items: center;

    border-radius: 50%;

    background: #dff5e5;

    border: 3px solid white;

    box-shadow: 0 5px 15px rgba(30, 90, 50, .15);
}

.point-1 {
    top: 150px;
    left: 235px;
}

.point-2 {
    top: 155px;
    right: 240px;
}

.point-3 {
    bottom: 145px;
    left: 280px;
}

.point-4 {
    bottom: 150px;
    right: 235px;
}

.location-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.location-card {
    display: flex;
    align-items: center;

    gap: 13px;

    padding: 17px;

    background: white;

    border: 1px solid #e3ebe6;

    border-radius: 13px;

    transition: .3s;
}

.location-card:hover {
    transform: translateX(5px);
    border-color: #8fcba0;
}

.location-card > span {
    margin-left: auto;

    color: #2c9550;
}

.location-icon {
    width: 42px;
    height: 42px;

    display: flex;
    justify-content: center;
    align-items: center;

    border-radius: 10px;

    font-size: 19px;
}

.dry-icon {
    background: #e6f1e8;
}

.wet-icon {
    background: #e8f5db;
}

.plastic-icon {
    background: #fff1c9;
}

.electronic-icon {
    background: #eee1f6;
}

.location-card h3 {
    font-size: 13px;
}

.location-card p {
    color: #78827c;

    font-size: 10px;
}


/* ================= REPORT ================= */

.report-container {
    max-width: 1100px;

    margin: auto;

    display: grid;
    grid-template-columns: 0.85fr 1.15fr;

    gap: 70px;

    align-items: center;
}

.report-info h2 {
    font-size: 44px;
    line-height: 1.1;

    margin: 14px 0;
}

.report-info > p {
    color: #737e76;

    font-size: 14px;

    max-width: 450px;

    margin-bottom: 25px;
}

.report-features {
    display: flex;
    flex-direction: column;
    gap: 12px;

    font-size: 12px;
    font-weight: 600;
}

.report-features span {
    color: white;

    background: #279348;

    width: 20px;
    height: 20px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    margin-right: 8px;
}

.report-form {
    background: #f7faf8;

    border: 1px solid #e2ebe5;

    border-radius: 20px;

    padding: 30px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 15px;
}

.form-group {
    display: flex;
    flex-direction: column;

    margin-bottom: 17px;
}

.form-group label {
    font-size: 11px;
    font-weight: 700;

    margin-bottom: 7px;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;

    border: 1px solid #dce6df;

    background: white;

    padding: 12px 13px;

    border-radius: 9px;

    outline: none;

    font-size: 12px;

    color: #334138;

    transition: .2s;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: #4aa867;

    box-shadow: 0 0 0 3px rgba(74, 168, 103, .1);
}

.form-group textarea {
    resize: vertical;
}

.submit-btn {
    width: 100%;

    border: none;

    background: #1d4a2c;
    color: white;

    padding: 14px;

    border-radius: 9px;

    font-size: 12px;
    font-weight: 800;

    transition: .3s;
}

.submit-btn:hover {
    background: #2a8f4c;
}


/* ================= TIPS ================= */

.tips-section {
    background: #f6faf7;
}

.tips-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 18px;
}

.tip-card {
    padding: 25px;

    background: white;

    border: 1px solid #e2ebe5;

    border-radius: 16px;

    transition: .3s;
}

.tip-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(30,90,50,.08);
}

.tip-card > span {
    font-size: 30px;
}

.tip-card h3 {
    margin: 14px 0 7px;

    font-size: 15px;
}

.tip-card p {
    color: #758078;

    font-size: 11px;
}


/* ================= POINTS ================= */

.points-section {
    padding: 100px 9%;

    background: #173c26;

    color: white;
}

.points-container {
    max-width: 1000px;

    margin: auto;

    display: grid;
    grid-template-columns: 1fr 330px;

    gap: 100px;

    align-items: center;
}

.points-content h2 {
    font-size: 50px;

    line-height: 1.05;

    margin: 14px 0;
}

.points-content p {
    color: #b8c9bd;

    font-size: 14px;

    max-width: 500px;

    margin-bottom: 25px;
}

.points-content .section-label {
    color: #7cda98;
}

.points-card {
    padding: 30px;

    background: white;

    color: #193322;

    border-radius: 20px;

    box-shadow: 0 25px 60px rgba(0,0,0,.18);
}

.points-top {
    display: flex;
    align-items: center;
    gap: 10px;

    color: #657269;

    font-size: 11px;
    font-weight: 800;
}

.points-top span {
    font-size: 28px;
}

.points-card h3 {
    font-size: 58px;

    line-height: 1;

    margin-top: 20px;
}

.points-card > p {
    color: #748078;

    font-size: 12px;
}

.progress {
    height: 7px;

    background: #e7eee9;

    border-radius: 20px;

    margin: 22px 0;
}

.progress-bar {
    width: 70%;
    height: 100%;

    background: #38a95b;

    border-radius: inherit;

    transition: .5s;
}

.level {
    display: flex;
    justify-content: space-between;

    font-size: 10px;
}

.level span {
    color: #7b857e;
}

.level strong {
    color: #299149;
}


/* ================= LEADERBOARD ================= */

.leaderboard {
    max-width: 750px;

    margin: auto;

    display: flex;
    flex-direction: column;

    gap: 10px;
}

.leader-row {
    display: grid;

    grid-template-columns: 50px 45px 1fr 100px;

    align-items: center;

    padding: 14px 18px;

    border: 1px solid #e4ebe6;

    border-radius: 13px;

    background: white;
}

.leader-row.top {
    background: #f3faf5;
    border-color: #cfe6d5;
}

.rank {
    font-size: 18px;
    font-weight: 800;
}

.avatar {
    width: 35px;
    height: 35px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #dff1e4;

    color: #247d3f;

    border-radius: 50%;

    font-weight: 800;
}

.student strong,
.student small {
    display: block;
}

.student strong {
    font-size: 13px;
}

.student small {
    color: #7c857f;
    font-size: 9px;
}

.leader-row > strong:last-child {
    text-align: right;

    color: #238d45;

    font-size: 12px;
}


/* ================= FOOTER ================= */

footer {
    background: #10271a;

    color: white;

    padding: 60px 9% 25px;
}

.footer-main {
    display: grid;

    grid-template-columns: 2fr 1fr 1fr;

    gap: 50px;

    padding-bottom: 45px;
}

.footer-brand p {
    max-width: 330px;

    color: #9eafa4;

    font-size: 12px;

    margin-top: 15px;
}

.footer-links {
    display: flex;
    flex-direction: column;

    gap: 9px;
}

.footer-links h4 {
    font-size: 12px;

    margin-bottom: 8px;
}

.footer-links a {
    color: #9eafa4;

    font-size: 11px;

    transition: .2s;
}

.footer-links a:hover {
    color: #75d28f;
}

.footer-bottom {
    display: flex;
    justify-content: space-between;

    padding-top: 20px;

    border-top: 1px solid #294132;

    color: #819287;

    font-size: 10px;
}


/* ================= TOAST ================= */

.toast {
    position: fixed;

    bottom: 25px;
    right: 25px;

    background: #173c26;
    color: white;

    padding: 15px 20px;

    border-radius: 10px;

    box-shadow: 0 15px 35px rgba(0,0,0,.2);

    z-index: 9999;

    animation: toastIn .3s ease;
}

@keyframes toastIn {
    from {
        transform: translateY(20px);
        opacity: 0;
    }

    to {
        transform: translateY(0);
        opacity: 1;
    }
}


/* ================= RESPONSIVE ================= */

@media (max-width: 1100px) {

    .navbar nav {
        gap: 15px;
    }

    .navbar {
        padding: 0 4%;
    }

    .hero,
    .section,
    .locator-section,
    .points-section {
        padding-left: 5%;
        padding-right: 5%;
    }

    .waste-grid,
    .tips-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero-visual {
        width: 350px;
    }

}

@media (max-width: 850px) {

    .navbar nav,
    .nav-btn {
        display: none;
    }

    .hero {
        flex-direction: column;

        text-align: center;

        gap: 60px;
    }

    .hero p {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons,
    .hero-trust {
        justify-content: center;
    }

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .locator-container,
    .report-container,
    .points-container {
        grid-template-columns: 1fr;
    }

    .points-container {
        gap: 40px;
    }

    .footer-main {
        grid-template-columns: 1fr 1fr;
    }

}

@media (max-width: 550px) {

    .hero {
        padding-top: 55px;
    }

    .hero h1 {
        font-size: 46px;
        letter-spacing: -2px;
    }

    .hero-visual {
        width: 100%;
        transform: scale(.8);
    }

    .stats,
    .waste-grid,
    .tips-grid {
        grid-template-columns: 1fr;
    }

    .section-heading h2 {
        font-size: 32px;
    }

    .report-info h2 {
        font-size: 36px;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .leader-row {
        grid-template-columns: 35px 40px 1fr 70px;
    }

    .footer-main {
        grid-template-columns: 1fr;
    }

    .footer-bottom {
        flex-direction: column;
        gap: 10px;
    }

}
